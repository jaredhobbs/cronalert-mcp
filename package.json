{
  "name": "cronalert-mcp",
  "version": "1.1.0",
  "description": "MCP server for CronAlert uptime monitoring — manage monitors from Claude, Cursor, or any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cronalert-mcp": "dist/bundle.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && esbuild dist/index.js --bundle --platform=node --format=cjs --banner:js='#!/usr/bin/env node' --outfile=dist/bundle.cjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "cronalert",
    "mcp",
    "uptime",
    "monitoring"
  ],
  "mcpName": "io.github.jaredhobbs/cronalert",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
